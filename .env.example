# Which engine runs inference: "modal" (cloud GPU) or "local" (CPU)
AUDBRE_ENGINE=modal

# Modal deployed function endpoint (printed by `modal deploy modal_app.py`)
AUDBRE_MODAL_URL=

# Model variant: sam-audio-small | sam-audio-base | sam-audio-large
AUDBRE_MODEL=facebook/sam-audio-large

# Hugging Face token - needs approved access to the gated SAM Audio repo
HF_TOKEN=

# Shared secret for YOUR OWN GPU worker. Modal web endpoints are public, so
# without this anyone who learns your URL can spend your credits. Must match
# the `audbre-worker` Modal secret. Generate with:
#   openssl rand -hex 24
AUDBRE_WORKER_TOKEN=

# Server
AUDBRE_HOST=127.0.0.1
AUDBRE_PORT=8000
